# Variables de entorno
# Copiar este archivo como .env y completar los valores

# URL base de la API de Rails (sin trailing slash)
VITE_API_URL=http://localhost:3000/api/v1

# Tenant a emular en desarrollo. Sólo se usa cuando el host no lo dice
# (localhost / 127.0.0.1) y no hay `?tenant=` en la URL; en producción el slug
# sale siempre del subdominio. Sin valor, se asume `norte`.
VITE_TENANT=norte
